{
  "$defs": {
    "backendConfig": {
      "additionalProperties": false,
      "properties": {
        "conn_max_idle_time": {
          "type": "string"
        },
        "conn_max_lifetime": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "delete": {
          "type": "boolean"
        },
        "driver": {
          "type": "string"
        },
        "dsn": {
          "type": "string"
        },
        "entities": {
          "additionalProperties": {
            "$ref": "#/$defs/entityConfig"
          },
          "description": "Entity-level configurations."
        },
        "id_map": {
          "additionalProperties": true,
          "deprecated": true,
          "description": "Optional mapping from entity (table) name to ID column.\nIf not specified, then 'id' is assumed"
        },
        "max_idle_connections": {
          "type": "integer"
        },
        "max_open_connections": {
          "type": "integer"
        },
        "pageSizeLimit": {
          "description": "Limit for page size. When per-entity limit is not configured, then this value is used.",
          "type": "integer"
        },
        "queries": {
          "additionalProperties": true,
          "description": "Named queries that can be executed by their name"
        },
        "read": {
          "type": "boolean"
        },
        "update": {
          "type": "boolean"
        }
      }
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "backends": {
          "additionalProperties": false,
          "patternProperties": {
            "^[\\w-]{1,63}$": {
              "$ref": "#/$defs/backendConfig"
            }
          },
          "type": "object"
        },
        "logging": {
          "$ref": "#/$defs/loggingConfig"
        },
        "pageSizeLimit": {
          "description": "Global default limit for page size.\nWhen neither per-entity, not per-backend limit is configured, then this value is applied.\nIf not specified, then value of 20 is assumed",
          "type": "integer"
        },
        "server": {
          "$ref": "https://raw.githubusercontent.com/rkosegi/go-http-commons/refs/heads/main/schemas/server.config.json"
        }
      },
      "required": [
        "backends",
        "server"
      ]
    },
    "entityConfig": {
      "properties": {
        "idColumn": {
          "description": "Name of ID column. If not specified, then 'id' is assumed",
          "type": "string"
        },
        "pageSizeLimit": {
          "description": "Limit for page size",
          "type": "integer"
        }
      }
    },
    "loggingConfig": {
      "additionalProperties": false,
      "description": "Logging configuration",
      "properties": {
        "format": {
          "type": "string"
        },
        "level": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://github.com/rkosegi/db2rest-bridge/schemas/config",
  "$ref": "#/$defs/config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Configuration schema",
  "type": "object"
}
