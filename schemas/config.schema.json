{
  "$defs": {
    "BackendConfig": {
      "additionalProperties": false,
      "properties": {
        "conn_max_idle_time": {
          "type": "string"
        },
        "conn_max_lifetime": {
          "type": "string"
        },
        "create": {
          "description": "Flag to enable create operations. When omitted, then false (disabled) is assumed",
          "type": "boolean"
        },
        "delete": {
          "description": "Flag to enable delete operations. When omitted, then false (disabled) is assumed",
          "type": "boolean"
        },
        "driver": {
          "description": "Type of driver to use",
          "enum": [
            "mysql"
          ],
          "type": "string"
        },
        "dsn": {
          "description": "Data source specification.\nCan contain credentials",
          "type": "string"
        },
        "entities": {
          "additionalProperties": {
            "$ref": "#/$defs/EntityConfig"
          },
          "description": "Entity-level configurations."
        },
        "id_map": {
          "additionalProperties": {
            "type": "string"
          },
          "deprecated": true,
          "description": "Optional mapping from entity (table) name to ID column.\nIf not specified, then 'id' is assumed",
          "x-deprecated-reason": "Use entities map"
        },
        "init_queries": {
          "description": "SQL queries to be executed at start. Be careful here.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_idle_connections": {
          "description": "Sets the maximum number of connections in the idle connection pool.",
          "type": "integer"
        },
        "max_open_connections": {
          "description": "Sets the maximum number of open connections to the database.",
          "type": "integer"
        },
        "page_size_limit": {
          "description": "Limit for page size. When per-entity limit is not configured, then this value is used.",
          "type": "integer"
        },
        "queries": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Named queries that can be executed by their name"
        },
        "read": {
          "description": "Flag to enable read operations. When omitted, then true (enabled) is assumed",
          "type": "boolean"
        },
        "update": {
          "description": "Flag to enable update operations. When omitted, then false (disabled) is assumed",
          "type": "boolean"
        }
      },
      "required": [
        "dsn"
      ]
    },
    "ClientProfile": {
      "properties": {
        "auth": {
          "additionalProperties": true,
          "description": "Authentication configuration. TBD"
        },
        "url": {
          "description": "URL to the server API endpoint",
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "ClientProfiles": {
      "additionalProperties": {
        "$ref": "#/$defs/ClientProfile"
      },
      "description": "Map of client profiles"
    },
    "Config": {
      "additionalProperties": false,
      "properties": {
        "active_client_profile": {
          "description": "Name of active client profile",
          "type": "string"
        },
        "backends": {
          "additionalProperties": {
            "$ref": "#/$defs/BackendConfig"
          },
          "patternProperties": {
            "^[\\w-]{1,63}$": {
              "$ref": "#/$defs/BackendConfig"
            }
          }
        },
        "client_profiles": {
          "$ref": "#/$defs/ClientProfiles"
        },
        "page_size_limit": {
          "description": "Global default limit for page size.\nWhen neither per-entity, not per-backend limit is configured, then this value is applied.\nIf not specified, then value of 20 is assumed",
          "type": "integer"
        },
        "server": {
          "$ref": "https://raw.githubusercontent.com/rkosegi/go-http-commons/refs/heads/main/schemas/server.config.json"
        }
      },
      "required": [
        "backends",
        "server"
      ],
      "type": "object"
    },
    "EntityConfig": {
      "properties": {
        "id_column": {
          "description": "Name of ID column. If not specified, then 'id' is assumed",
          "type": "string"
        },
        "page_size_limit": {
          "description": "Limit for page size",
          "type": "integer"
        }
      }
    }
  },
  "$id": "https://github.com/rkosegi/db2rest-bridge/schemas/Config",
  "$ref": "#/$defs/Config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Configuration schema",
  "type": "object"
}
